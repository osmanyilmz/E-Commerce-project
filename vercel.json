{
  "routes": [
    {
      "src": "^/(login|signup)$",
      "methods": ["POST"],
      "dest": "https://e-commerce-backend-ruby-seven.vercel.app/$1"
    },
    {
      "src": "^/user/.*",
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "dest": "https://e-commerce-backend-ruby-seven.vercel.app$0"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
