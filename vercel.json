{
  "routes": [
    {
      "src": "^/(login|signup|user/.*)$",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
      "dest": "https://e-commerce-backend-ruby-seven.vercel.app/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
